# Copy to backend/.env - never commit the real file.
# Hugging Face token: https://huggingface.co/settings/tokens  (fine-grained, "Make calls to Inference Providers")
HF_TOKEN=
# Open-source chat model served by Hugging Face Inference Providers (must support tool calling)
LLM_MODEL=openai/gpt-oss-120b
# Tried in order if the main model fails (comma-separated)
LLM_FALLBACK_MODELS=Qwen/Qwen3.8-27B
# auto = let Hugging Face pick a provider; or groq, cerebras, deepinfra, novita, ...
HF_PROVIDER=auto
# 1 = never call the LLM (demo with Wi-Fi off)
ASTRODOC_OFFLINE=0
# auto | chroma | tfidf
ASTRODOC_RETRIEVER=auto
# Optional: use another OpenAI-compatible host for open models instead of Hugging Face routing.
# Leave empty for Hugging Face. Best fully free setup = Groq (free plan, no card, key at https://console.groq.com/keys):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=<your Groq key>
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b   (each model has its own free limit)
LLM_BASE_URL=
LLM_API_KEY=
# gpt-oss models only: low | medium | high (low keeps replies fast and within free-tier token limits)
LLM_REASONING_EFFORT=low
# Voice input: open-source Whisper on the same host as the chat model (Groq free plan)
STT_MODEL=whisper-large-v3-turbo
STT_FALLBACK_MODELS=whisper-large-v3
# empty = auto-detect language
STT_LANGUAGE=en
