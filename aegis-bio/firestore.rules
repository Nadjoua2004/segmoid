rules_version = '2';

// Aegis-Bio (Team Sigmoid - NASA Space Apps Challenge)
// Operational Firestore Security Rules — Hackathon Prototyping Configuration
// Note: NASA RAG Vector Knowledge Base is stored locally in ChromaDB, NOT in Firestore.
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Astronaut Crew Profiles & High-Frequency Telemetry Subcollection
    match /astronauts/{astroId} {
      allow read, write: if true;

      match /telemetry_logs/{logId} {
        allow read, write: if true;
      }
    }

    // 2. Subjective Daily Check-Ins ({astroId}_day_{missionDay})
    match /daily_checkins/{checkinId} {
      allow read, write: if true;
    }

    // 3. Real-Time Clinical Triage Alerts
    match /triage_alerts/{alertId} {
      allow read, write: if true;
    }

    // 4. AI Flight Surgeon Chat Sessions & Messages Subcollection
    match /chat_sessions/{sessionId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 5. Intra-Crew Dead-Man's Switch Escalations ({astroId}_escalation)
    match /emergency_escalations/{escalationId} {
      allow read, write: if true;
    }

    // 6. 7-Day Vital Degradation & Cognitive Strain Predictions ({astroId}_trajectory)
    match /health_predictions/{trajectoryId} {
      allow read, write: if true;
    }

    // Fallback rule for rapid hackathon prototyping
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
