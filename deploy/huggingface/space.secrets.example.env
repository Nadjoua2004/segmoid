# Copy this file to space.secrets.env (git-ignored) and fill it in.
# deploy_space.py stores these as Hugging Face Space secrets/variables; they never go into git.

# --- used only by deploy_space.py, never uploaded ---
# Hugging Face token with WRITE access: https://huggingface.co/settings/tokens
HF_DEPLOY_TOKEN=

# --- secrets ---
# Groq API key (free plan): https://console.groq.com/keys
LLM_API_KEY=
# Supabase Postgres of the NEW app project -> Connect -> "Session pooler" connection string (IPv4)
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Leave empty: generated on the first deploy and saved here
SECRET_KEY=

# --- variables ---
# The Vercel address of the frontend (comma-separated if several)
FRONTEND_ORIGINS=https://<your-project>.vercel.app
# Optional: allow Vercel preview deployments too
FRONTEND_ORIGIN_REGEX=
